{
    "random_seed": 42,
    "text_feature": {
        "ngram_range": [2, 2],
        "min_df": 2,
        "max_features": 50000
    },
    "naive_bayes": {
        "alpha": 0.05
    },
    "fwnb": {
        "minimum_weight": 0.25,
        "maximum_boost": 0.5,
        "gamma": 1.0
    },
    "dfwnb_v2": {
        "candidate_feature_count": 2000,
        "maximum_features_per_document": 80,
        "minimum_pair_df": 20,
        "minimum_jaccard": 0.03,
        "top_k": 3,
        "support_tau": 30.0,
        "redundancy_strength": 1.0,
        "redundancy_gamma": 0.5,
        "direction_smoothing": 0.5
    },
    "sdfwnb": {
        "minimum_pair_df": 8,
        "support_tau": 30.0,
        "smoothing": 0.5,
        "delta_clip": 4.0,
        "dependency_pair_count": 1000,
        "dependency_strength": 1.0,
        "maximum_pairs_per_document": 30
    },
    "final_test": {
        "train_dev_merge": true,
        "bootstrap_resamples": 5000,
        "bootstrap_seed_offset": 100
    }
}
